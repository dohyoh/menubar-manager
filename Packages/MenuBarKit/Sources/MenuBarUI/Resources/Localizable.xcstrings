          }
        }
      }
    },
    "설정을 가져와 적용했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings imported and applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入并应用设置。"
          }
        }
      }
    },
    "설정을 내보냈습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings exported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导出设置。"
          }
        }
      }
    },
    "설치됨 · 실행 중 아님": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed · not running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装 · 未运行"
          }
        }
      }
    },
    "순서 편집": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Order"
          }
        },
        "zh-Hans": {
          "stringUnit": {
