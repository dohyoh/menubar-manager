            "value": "清除"
          }
        }
      }
    },
    "진단": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断"
          }
        }
      }
    },
    "진단 정보 복사": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Diagnostics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝诊断信息"
          }
        }
      }
    },
    "취소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "컴퓨터를 켜고 로그인하면 자동으로 시작합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts automatically when you log in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机并登录后自动启动。"
          }
        }
      }
    },
    "키 조합을 누르세요…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a key combination…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按下组合键…"
          }
        }
      }
    },
    "탭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页"
          }
        }
      }
    },
    "펼친 뒤 자동으로 다시 숨기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide again automatically after expanding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开后自动重新隐藏"
          }
        }
      }
    },
    "표시": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示"
          }
        }
      }
    },
    "표시 %lld개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown (%lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示（%lld）"
          }
        }
      }
    },
    "필터": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选"
          }
        }
      }
    },
    "해당하는 앱이 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps to show."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有符合条件的 App。"
          }
        }
      }
    },
    "현재 상태": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current State"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前状态"
          }
        }
      }
    },
    "확인": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
