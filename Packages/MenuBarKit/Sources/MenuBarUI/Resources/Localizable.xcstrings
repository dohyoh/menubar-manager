    "순서를 적용했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The order has been applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已应用顺序。"
          }
        }
      }
    },
    "숨기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏"
          }
        }
      }
    },
    "숨기기 끄기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Hiding Off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭隐藏"
          }
        }
      }
    },
    "숨기기 켜고 끄기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning hiding on and off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启和关闭隐藏"
          }
        }
      }
    },
    "숨기기 켜기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Hiding On"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启隐藏"
          }
        }
      }
    },
    "숨기기가 꺼져 있습니다 (전부 표시)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding is off (showing all)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏已关闭（全部显示）"
          }
        }
      }
    },
    "숨긴 앱": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已隐藏"
          }
        }
      }
    },
    "숨긴 앱 펼치기 / 숨기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanding and hiding hidden apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开 / 隐藏被隐藏的 App"
          }
        }
      }
    },
    "숨길 앱 고르기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choosing apps to hide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要隐藏的 App"
          }
        }
      }
    },
    "숨길 앱 목록과 옵션을 파일로 저장하거나 불러옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the hidden apps and options to a file, or load them from one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把隐藏列表和选项保存到文件，或从文件载入。"
          }
        }
      }
    },
    "숨길 앱의 스위치를 끈 다음, 메뉴바의 이 앱 아이콘을 우클릭해 \"숨기기\"를 켜세요. 아이콘을 좌클릭하면 숨긴 앱이 잠깐 펼쳐집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off the switch for each app you want to hide, then right-click this app's icon in the menu bar and turn on \"Hide\". Click the icon to reveal hidden apps for a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先关闭要隐藏的 App 的开关，然后右键点击菜单栏中这个 App 的图标并开启“隐藏”。左键点击图标可以暂时展开被隐藏的 App。"
          }
        }
      }
    },
    "숨김": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏"
          }
        }
      }
    },
    "숨김 %lld개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden (%lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏（%lld）"
          }
        }
      }
    },
    "숨김 기능 사용 가능": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding Available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏功能可用"
          }
        }
      }
    },
    "숨김 적용 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏中"
          }
        }
      }
    },
    "숨김 적용에 실패했습니다 (전부 표시)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not apply hiding (showing all)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法应用隐藏（全部显示）"
          }
        }
      }
    },
    "숨김 중에도 메뉴바의 시계를 누르면 알림 센터가 열립니다 (열려 있는 동안 숨긴 아이콘이 잠깐 보입니다). 트랙패드를 쓸어서 여는 경우에는 먼저 이 앱 아이콘을 좌클릭해 펼쳐 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicking the clock in the menu bar opens Notification Center even while hiding is on (hidden icons show briefly while it is open). If you open it by swiping on the trackpad, click this app's icon first to expand."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏期间点击菜单栏的时钟也能打开通知中心（打开期间被隐藏的图标会暂时显示）。如果是在触控板上轻扫打开，请先左键点击这个 App 的图标展开。"
          }
        }
      }
    },
    "스위치를 끄면 그 앱의 아이콘이 숨겨집니다. 목록에는 메뉴바 아이콘이 없는 앱도 포함됩니다 — \"순서 편집\"에서 접근성 권한을 허용하면 메뉴바에 있는 앱만 볼 수 있습니다. 제어 센터에서 메뉴바로 꺼낸 항목(타이머 등)은 숨김 중에는 항상 숨겨집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn a switch off to hide that app's icon. The list also includes apps without a menu bar icon — allow Accessibility permission in \"Edit Order\" to see only apps that are in the menu bar. Items added to the menu bar from Control Center (such as Timer) are always hidden while hiding is on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭开关即可隐藏该 App 的图标。列表中也包含没有菜单栏图标的 App — 在“编辑顺序”中允许辅助功能权限后，可以只查看菜单栏中的 App。从控制中心添加到菜单栏的项目（如计时器）在隐藏期间始终隐藏。"
          }
        }
      }
    },
    "스위치를 끄면 그 앱의 아이콘이 숨겨집니다. 제어 센터에서 메뉴바로 꺼낸 항목(타이머 등)은 숨김 중에는 항상 숨겨집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn a switch off to hide that app's icon. Items added to the menu bar from Control Center (such as Timer) are always hidden while hiding is on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭开关即可隐藏该 App 的图标。从控制中心添加到菜单栏的项目（如计时器）在隐藏期间始终隐藏。"
          }
        }
      }
    },
    "시계·제어 센터·Wi-Fi 등 — 옮길 수 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock, Control Center, Wi-Fi, etc. — cannot be moved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时钟、控制中心、Wi-Fi 等 — 无法移动"
          }
        }
      }
    },
    "시스템 아이콘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Icons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统图标"
          }
        }
      }
    },
    "시스템 항목": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System item"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统项目"
          }
        }
      }
    },
    "시스템 항목 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System item %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统项目 %@"
          }
        }
      }
    },
    "시작하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting started"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用"
          }
        }
      }
    },
    "실행 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在运行"
          }
        }
      }
    },
    "아니요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否"
          }
        }
      }
    },
    "아이콘을 옮기는 중… %@/%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving icons… %@/%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在移动图标… %@/%@"
          }
        }
      }
    },
    "아이콘을 우클릭한 뒤 \"숨기기\" 스위치를 사용합니다. 끄면 다시 켤 때까지 모든 아이콘을 표시합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click the icon and use the \"Hide\" switch. While it is off, every icon stays visible until you turn it back on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点击图标，然后使用“隐藏”开关。关闭后，在重新开启之前所有图标都会显示。"
          }
        }
      }
    },
    "알 수 없음 (접근성 권한 필요)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown (needs Accessibility permission)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知（需要辅助功能权限）"
          }
        }
      }
    },
    "알림 센터": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification Center"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知中心"
          }
        }
      }
    },
    "알아 둘 점": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to know"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "须知"
          }
        }
      }
    },
    "앱 버전": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 版本"
          }
        }
      }
    },
    "앱 이름 검색": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索 App 名称"
          }
        }
      }
    },
    "앱을 다시 시작하면 적용됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes effect after you restart the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 App 后生效。"
          }
        }
      }
    },
    "언어": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
    "예": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是"
          }
        }
      }
    },
    "옮기지 못했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Move the App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移动"
          }
        }
      }
    },
    "우클릭 > 설정…의 \"메뉴바 관리\"에서 앱별 스위치를 끄면 그 앱의 아이콘이 숨겨집니다. 앱이 많으면 검색과 필터로 찾습니다. 목록 아래쪽에서 Wi-Fi·배터리 같은 시스템 아이콘도 고를 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Right-click > Settings…, under \"Menu Bar\", turn off an app's switch to hide its icon. Use search and filters if you have many apps. System icons such as Wi-Fi and Battery are at the bottom of the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“右键 > 设置…”的“菜单栏管理”中关闭某个 App 的开关，即可隐藏它的图标。App 较多时可以用搜索和筛选来查找。在列表下方还可以选择 Wi-Fi、电池等系统图标。"
          }
        }
      }
    },
    "응용 프로그램 폴더 밖 — 숨김 중에는 표시할 수 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside the Applications folder — cannot be shown while hiding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于“应用程序”文件夹之外 — 隐藏期间无法显示"
          }
        }
      }
    },
    "응용 프로그램 폴더 밖에 있는 앱과 제어 센터에서 꺼낸 항목(타이머 등)은 숨김 중에는 표시되지 않습니다. 이 앱을 종료하면 숨긴 아이콘은 모두 돌아옵니다. 아이콘이 보이지 않을 때는 응용 프로그램 폴더에서 이 앱을 다시 열면 설정 창이 나타납니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps outside the Applications folder and items added from Control Center (such as Timer) are not shown while hiding is on. Quitting this app brings back every hidden icon. If this app's icon is not visible, open the app again from the Applications folder to show the Settings window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于“应用程序”文件夹之外的 App，以及从控制中心添加的项目（如计时器），在隐藏期间不会显示。退出这个 App 后，被隐藏的图标会全部恢复。看不到图标时，从“应用程序”文件夹再次打开这个 App，就会出现设置窗口。"
          }
        }
      }
    },
    "응용 프로그램 폴더로 옮겨 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to the Applications folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请移到“应用程序”文件夹"
          }
        }
      }
    },
    "응용 프로그램 폴더로 옮기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Applications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到“应用程序”文件夹"
          }
        }
      }
    },
    "응용 프로그램 폴더로 옮긴 뒤 다시 실행해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move it to the Applications folder and reopen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请移到“应用程序”文件夹后重新打开"
          }
        }
      }
    },
    "응용 프로그램 폴더에 설치됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed in Applications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装在“应用程序”文件夹"
          }
        }
      }
    },
    "응용 프로그램 폴더에서 실행해야 숨김을 켤 수 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding only works when the app runs from the Applications folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须从“应用程序”文件夹运行才能开启隐藏"
          }
        }
      }
    },
    "이 macOS 버전에서는 숨김 기능을 쓸 수 없습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding is not available on this version of macOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 macOS 版本无法使用隐藏功能"
          }
        }
      }
    },
    "이 macOS 버전에서는 숨김을 쓸 수 없습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding is not available on this macOS version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 macOS 版本无法使用隐藏"
          }
        }
      }
    },
    "이 앱 — 항상 표시": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app — always shown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 App — 始终显示"
          }
        }
      }
    },
    "이 앱이 ⌘을 누른 채 아이콘을 끄는 동작을 대신 수행하기 때문입니다. 숨기기와 펼치기에는 이 권한이 필요하지 않습니다. 시스템 설정 > 개인정보 보호 및 보안 > 손쉬운 사용에서 MenuBarManager를 켜 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app performs the ⌘-drag for you. Hiding and expanding do not need this permission. Turn on MenuBarManager in System Settings > Privacy & Security > Accessibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为这个 App 会代你执行“按住 ⌘ 拖动图标”的操作。隐藏和展开不需要此权限。请在“系统设置 > 隐私与安全性 > 辅助功能”中打开 MenuBarManager。"
          }
        }
      }
    },
    "이 조합은 등록하지 못했습니다. 다른 앱이 이미 쓰고 있을 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut couldn't be registered. Another app may already be using it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法注册这个组合键。可能已被其他 App 使用。"
          }
        }
      }
    },
    "이 파일은 가져올 수 없습니다. MenuBarManager 에서 내보낸 설정 파일인지 확인해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file can't be imported. Make sure it's a settings file exported from MenuBarManager."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导入此文件。请确认它是从 MenuBarManager 导出的设置文件。"
          }
        }
      }
    },
    "일반": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "일부 아이콘을 옮기지 못했습니다. 목록을 실제 순서로 맞췄습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some icons could not be moved. The list now shows the actual order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分图标无法移动。列表已按实际顺序更新。"
          }
        }
      }
    },
    "읽거나 적용하는 동안 숨긴 아이콘이 잠깐 나타나고, 적용 중에는 포인터가 잠깐 움직입니다. 시스템 항목(시계, 제어 센터 등)은 옮길 수 없지만 그 사이로 다른 아이콘을 옮길 수는 있습니다. 메뉴바에서 ⌘을 누른 채 직접 끌어도 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While reading or applying, hidden icons appear briefly, and the pointer moves for a moment while applying. System items (clock, Control Center, and so on) cannot be moved, but you can move other icons between them. You can also hold ⌘ and drag icons directly in the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取或应用期间，被隐藏的图标会暂时显示；应用期间指针会短暂移动。系统项目（时钟、控制中心等）无法移动，但可以把其他图标移到它们之间。也可以在菜单栏中按住 ⌘ 直接拖动。"
          }
        }
      }
    },
    "자동으로 다시 숨기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding again automatically"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动重新隐藏"
          }
        }
      }
    },
    "잠깐 펼친 상태": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily expanded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时展开"
          }
        }
      }
    },
    "적용": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "전역 단축키": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global Shortcuts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键"
          }
        }
      }
    },
    "전체": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "전체 %lld개 · 숨김 %lld개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld apps · %lld hidden"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 个 · 隐藏 %lld 个"
          }
        }
      }
    },
    "접근성 권한 (순서 조정용)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility Permission (for reordering)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限（用于调整顺序）"
          }
        }
      }
    },
    "접근성 권한 요청": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request Accessibility Permission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求辅助功能权限"
          }
        }
      }
    },
    "접근성 권한이 필요합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限。"
          }
        }
      }
    },
    "정보": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "종료": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出"
          }
        }
      }
    },
    "지금 다시 시작": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重新启动"
          }
        }
      }
